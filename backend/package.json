{
  "name": "cover-app-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API server for the AI style-transfer cover app: job queue + engine adapters",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/lifecycle.test.ts test/style-prompts.test.ts test/credits.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "better-sqlite3": "^11.10.0",
    "expo-server-sdk": "^3.15.0",
    "fastify": "^4.29.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
